# contracts — Foundry deployment
# Copy to .env. `forge script` reads these via vm.envUint / vm.envAddress.

# ─── Deployer ──────────────────────────────────────────────────────────────
# Local/testnet only. For anything real, use `--ledger` or `--trezor` and do
# not put a key in a file.
PRIVATE_KEY=

# ─── RPC ───────────────────────────────────────────────────────────────────
# Referenced by [rpc_endpoints] in foundry.toml as ${WORLDCHAIN_RPC} etc.
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
WORLDCHAIN_SEPOLIA_RPC=https://worldchain-sepolia.g.alchemy.com/public

# ─── Constructor arguments ─────────────────────────────────────────────────
# World ID Address Book. AvalRegistry.isAnchor() calls getIsUserVerified()
# on this address — it is the bottom of the whole fixed point, so a wrong
# value here silently floors every score in the system to base.
ADDRESS_BOOK_ADDRESS=0x57b930D551e677CC36e2fA036Ae2fe8FdaE0330D

# The backend key allowed to sign EIP-712 attestations (voucher tier, report
# weight, presence). Compromise mints enrollments — see docs/02-contracts.md
# §2.1. Rotatable: `attestors` is a mapping, not a single address.
ATTESTOR_ADDRESS=

# Holds confirmFraud() and juror assignment. Multisig, not an EOA.
# This is the least decentralized surface in the protocol and is named as a
# non-goal in docs/00-prd.md §8 rather than dressed up.
GOVERNOR_ADDRESS=

# ─── Verification ──────────────────────────────────────────────────────────
# Verify before recording any demo — not the night before.
WORLDSCAN_API_KEY=
ETHERSCAN_API_KEY=

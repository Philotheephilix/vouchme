# ═══════════════════════════════════════════════════════════════════════════
#  VouchMe — root environment
#
#  Copy to `.env` and fill in. Never commit real values; `.env*` is gitignored
#  except this file.
#
#  Each package also has its own `.env.example` with the subset it needs:
#    contracts/  deploy keys, RPC, verification
#    gateway/    CCIP-Read signer, subgraph access
#    mcp/        subgraph access, x402
#    app/        World ID, attestor, contract addresses
#    subgraph/   Graph deploy key
#
#  Values marked REQUIRED have no working default. Values marked PUBLIC are
#  safe to expose to the browser. Everything else is server-side only.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Chain ─────────────────────────────────────────────────────────────────
# World Chain mainnet is eip155:480; Sepolia is eip155:4801.
CHAIN_ID=480
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
WORLDCHAIN_SEPOLIA_RPC=https://worldchain-sepolia.g.alchemy.com/public

# World ID Address Book — the anchor oracle. `getIsUserVerified(address)`.
# This is the ONLY externally-grounded fact in the protocol, so it is read
# live and never cached in the scoring path (docs/03-worldid.md §3).
# Mainnet value below is from World's docs. VERIFY the Sepolia value separately
# before deploying to testnet — it is not documented.
ADDRESS_BOOK_ADDRESS=0x57b930D551e677CC36e2fA036Ae2fe8FdaE0330D

# ─── Deployed contracts ────────────────────────────────────────────────────
# Filled in by `contracts/script/Deploy.s.sol` output. All six are needed for
# the subgraph manifest and the app.
VOUCHME_REGISTRY_ADDRESS=
VOUCHME_TOKEN_ADDRESS=
CREDIBILITY_VAULT_ADDRESS=
REPORT_REGISTRY_ADDRESS=
PLATFORM_REGISTRY_ADDRESS=
PRESENCE_DRIP_ADDRESS=

# Block at which the contracts were deployed. The subgraph manifest MUST use
# this as `startBlock` — starting from 0 will not finish indexing in any
# reasonable time.
DEPLOY_BLOCK=

# ─── The Graph ─────────────────────────────────────────────────────────────
# REQUIRED for the gateway and MCP to read the trust graph.
VOUCHME_SUBGRAPH_ID=
VOUCHME_SUBGRAPH_URL=
# Gateway API key from Subgraph Studio. If unset, the x402 path is used instead.
GRAPH_API_KEY=

# x402 — per-query USDC payment, for agents that cannot hold an API key.
# Settlement is on Base (docs/05-graph-data-layer.md §4).
X402_PRIVATE_KEY=
X402_CHAIN=base

# ─── World ID ──────────────────────────────────────────────────────────────
# From the World Developer Portal.
NEXT_PUBLIC_APP_ID=
RP_ID=

# The nullifier namespace. CHANGING THIS RESETS EVERY UNIQUENESS GUARANTEE —
# every enrolled human could enroll again with a fresh nullifier. It is
# versioned so a deliberate reset is possible and an accidental one is not.
#
# The vouch presence proof uses THIS SAME ACTION, because nullifiers are
# unlinkable across actions and a separate action could never be tied back to
# the enrolled human (docs/03-worldid.md §5.1, errata E-1). The specific vouch
# is bound via `signal`, not via the action string.
#
# The `aval-` prefix is deliberate and survived the rename to VouchMe. The action is registered
# in the World Developer Portal, off this repo, and every nullifier ever issued is derived from
# it. Renaming it to `vouchme-enroll-v1` would not be a cosmetic change: it would be a new,
# unregistered action, so verification would fail outright, and if it were registered, every
# enrolled human could enroll a second time. Left as-is on purpose.
WORLD_ID_ACTION=aval-enroll-v1

# ─── Attestor ──────────────────────────────────────────────────────────────
# Signs the EIP-712 attestations the contracts check: enrollment (World ID
# proof verified) and vouch (presence verified + voucher tier).
#
# This is the protocol's largest trust assumption — see docs/02-contracts.md
# §2.1. In production this key lives in a KMS/HSM and is NEVER read from a
# file, never in a client bundle, never used to generate RP signatures
# client-side. The variable exists for local development only.
ATTESTOR_PRIVATE_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
# The ONLY persistent store. Holds World ID nullifiers (which must not be
# public), attestation nonces for replay protection, and sessions.
#
# There is no `scores` table and no `vouches` table — the graph lives in the
# Subgraph. Adding one is the moment this stops being verifiable
# (docs/07-app-api.md §6).
#
# nullifier_hash MUST be NUMERIC(78,0). Never BIGINT, never a JS number:
# a silently truncated nullifier is a Sybil hole, not a display bug.
DATABASE_URL=postgres://vouchme:vouchme@localhost:5432/vouchme

# ─── Services ──────────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:3000/api

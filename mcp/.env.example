# @vouchme/mcp — environment
#
# The server is READ-ONLY over the trust graph and has no `vouchme_vouch` tool:
# vouching requires human presence, which an agent cannot have.
#
# There is no deployed VouchMe Subgraph for this task (deployments/worldchain-sepolia.json's own
# notes). The 8 tools that must work regardless of any of the config below — vouchme_resolve,
# vouchme_score, vouchme_explain, vouchme_gate, vouchme_path, vouchme_candidates, vouchme_anchor_status,
# vouchme_simulate_vouch — read World Chain Sepolia directly (src/chain.ts: VouchMeRegistry events +
# GenesisAnchorBook.getIsUserVerified) and need NO configuration at all to work out of the box;
# contract addresses and the deployment block come from deployments/worldchain-sepolia.json, not
# from env vars. The remaining tools (vouchme_report, vouchme_report_status, vouchme_platform,
# vouchme_request_score, vouchme_query, and the VouchMe leg of vouchme_cross_protocol_trust's ReportRegistry /
# PlatformRegistry reads) still depend on a Subgraph that was never built for those two contracts
# — they refuse with a named `GraphClientConfigError` when VOUCHME_SUBGRAPH_ID isn't set, rather than
# fabricating a report/platform record.

# ─── World Chain Sepolia (chainId 4801) — optional overrides ──────────────
# Tenderly primary, Alchemy public fallback ONLY (Alchemy's public endpoint rate-limits hard) —
# see src/chain.ts's buildTransport(). Both have working defaults; only set these to point at a
# different RPC (e.g. your own funded key) during local development.
WORLDCHAIN_SEPOLIA_RPC=https://worldchain-sepolia.gateway.tenderly.co
WORLDCHAIN_SEPOLIA_RPC_FALLBACK=https://worldchain-sepolia.g.alchemy.com/public

# ─── The Graph — only for vouchme_report / vouchme_report_status / vouchme_platform /
# vouchme_request_score / vouchme_query (ReportRegistry + PlatformRegistry data, not deployed as a
# Subgraph for this task) ────────────────────────────────────────────────────
VOUCHME_SUBGRAPH_ID=
VOUCHME_SUBGRAPH_URL=

# Path A — API key from Subgraph Studio. Best for long-running servers.
GRAPH_API_KEY=

# Path B — x402, per-query USDC on Base. No account, no key, payment and
# access in one HTTP request. This is the path for autonomous agents that
# cannot store long-term credentials (docs/05-graph-data-layer.md §4).
# If GRAPH_API_KEY is unset, this is used instead.
X402_PRIVATE_KEY=
X402_CHAIN=base

# ─── Cross-protocol trust (vouchme_cross_protocol_trust) ──────────────────────
# ONE standardized query across every protocol and chain indexed under the
# Trust Graph Standard v0.2.0 (docs/17-trust-graph-standard.md) — today VouchMe
# on World Chain plus EAS on Base, Optimism, Arbitrum and Ethereum. Non-VouchMe
# edges are CONTEXT ONLY and never feed a VouchMe score: importing another
# protocol's edges would import its Sybil surface (docs/05 §3.5).
#
# There are no longer any per-protocol URLs to configure, and that is the
# point — the tool talks to ONE standardized store, so registering a new
# protocol adds no configuration here and changes no code in the tool.
# This is substreams/service/server.mjs (`node substreams/service/server.mjs`),
# reading the `trust_edges` table the composable Substreams package writes.
# If it is unreachable the tool reports that by name in `unavailable` rather
# than returning a fabricated empty result.
TRUST_GRAPH_SERVICE_URL=http://127.0.0.1:8790

# Deadline for the VouchMe-SPECIFIC engine read (a chunked eth_getLogs replay of
# VouchMeRegistry, used only to attach the normalized `vouchMeWeight` to VouchMe edges).
# It is an enrichment, not the answer: on timeout the tool still returns every
# standardized edge, including VouchMe's, and says the enrichment was skipped.
VOUCHME_ENGINE_TIMEOUT_MS=8000

# ─── Write operations ──────────────────────────────────────────────────────
# VOUCHME_OPERATOR_ADDRESS is the human or platform this server acts on behalf
# of — required for both vouchme_request_score (attributed lookup, logged to
# the subject) and vouchme_report (bonded accusation), since docs/06-mcp-skills.md's
# signature for each has no explicit "requester"/"reporter" parameter. Leave
# unset for a read-only server and both tools refuse with a named
# `NoOperator` error rather than running unattributed.
VOUCHME_OPERATOR_ADDRESS=

# AGENT_PRIVATE_KEY / PLATFORM_REGISTRY_ADDRESS / REPORT_REGISTRY_ADDRESS are
# for actually SUBMITTING the on-chain transaction (ScoreRequested / file())
# once VOUCHME_OPERATOR_ADDRESS above lets a tool proceed past the attribution
# check — not yet wired to a signer in this scaffold (see mcp/README.md's
# scope notes); every check vouchme_report runs before that point (tier,
# connection, cooldown, etc.) is real and enforced regardless.
#
# vouchme_report SPENDS VOUCHME. The bond is 10 VOUCHME per weight point, and a
# MALICIOUS arbitration verdict slashes it and voids every report this
# operator has ever filed.
AGENT_PRIVATE_KEY=
PLATFORM_REGISTRY_ADDRESS=
REPORT_REGISTRY_ADDRESS=

# ─── Pipeline deployment (vouchme_pipeline_preview / _deploy) ─────────────────
# Natural language -> deployed Substreams pipeline. Deploy REFUSES any preview
# that decoded zero events: a pipeline that deploys cleanly and indexes nothing
# is indistinguishable from a working one until somebody queries it a week
# later (docs/14-substreams.md §3). Deploy ALSO refuses with a named
# `NotConfigured` error when either of these two is unset — there is no
# Substreams backend to submit a manifest to otherwise.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=

# @aval/mcp — environment
#
# The server is READ-ONLY over the trust graph and has no `aval_vouch` tool:
# vouching requires human presence, which an agent cannot have. Three tools do
# have effects (aval_request_score, aval_report, aval_pipeline_deploy) and each
# needs credentials below.
#
# Minimal config: set either GRAPH_API_KEY or X402_PRIVATE_KEY, plus
# AVAL_SUBGRAPH_ID. Everything else is optional.

# ─── The Graph ─────────────────────────────────────────────────────────────
AVAL_SUBGRAPH_ID=
AVAL_SUBGRAPH_URL=

# Path A — API key from Subgraph Studio. Best for long-running servers.
GRAPH_API_KEY=

# Path B — x402, per-query USDC on Base. No account, no key, payment and
# access in one HTTP request. This is the path for autonomous agents that
# cannot store long-term credentials (docs/05-graph-data-layer.md §4).
# If GRAPH_API_KEY is unset, this is used instead.
X402_PRIVATE_KEY=
X402_CHAIN=base

# ─── Chain reads ───────────────────────────────────────────────────────────
# aval_anchor_status calls getIsUserVerified() live, cached 60s at most.
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
ADDRESS_BOOK_ADDRESS=0x57b930D551e677CC36e2fA036Ae2fe8FdaE0330D

# ─── Cross-protocol trust (aval_cross_protocol_trust) ──────────────────────
# One standardized query fanned across three chains. Non-Aval edges are
# CONTEXT ONLY and never feed an Aval score — importing another protocol's
# edges would import its Sybil surface (docs/05-graph-data-layer.md §3.5).
CIRCLES_SUBGRAPH_URL=
ENS_SUBGRAPH_URL=

# ─── Write operations ──────────────────────────────────────────────────────
# AVAL_OPERATOR_ADDRESS is the human or platform this server acts on behalf
# of — required for both aval_request_score (attributed lookup, logged to
# the subject) and aval_report (bonded accusation), since docs/06-mcp-skills.md's
# signature for each has no explicit "requester"/"reporter" parameter. Leave
# unset for a read-only server and both tools refuse with a named
# `NoOperator` error rather than running unattributed.
AVAL_OPERATOR_ADDRESS=

# AGENT_PRIVATE_KEY / PLATFORM_REGISTRY_ADDRESS / REPORT_REGISTRY_ADDRESS are
# for actually SUBMITTING the on-chain transaction (ScoreRequested / file())
# once AVAL_OPERATOR_ADDRESS above lets a tool proceed past the attribution
# check — not yet wired to a signer in this scaffold (see mcp/README.md's
# scope notes); every check aval_report runs before that point (tier,
# connection, cooldown, etc.) is real and enforced regardless.
#
# aval_report SPENDS AVAL. The bond is 10 AVAL per weight point, and a
# MALICIOUS arbitration verdict slashes it and voids every report this
# operator has ever filed.
AGENT_PRIVATE_KEY=
PLATFORM_REGISTRY_ADDRESS=
REPORT_REGISTRY_ADDRESS=

# ─── Pipeline deployment (aval_pipeline_preview / _deploy) ─────────────────
# Natural language -> deployed Substreams pipeline. Deploy REFUSES any preview
# that decoded zero events: a pipeline that deploys cleanly and indexes nothing
# is indistinguishable from a working one until somebody queries it a week
# later (docs/14-substreams.md §3). Deploy ALSO refuses with a named
# `NotConfigured` error when either of these two is unset — there is no
# Substreams backend to submit a manifest to otherwise.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=

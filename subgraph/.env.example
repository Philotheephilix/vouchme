# subgraph — deployment
# `graph auth` / `graph deploy` read these.

# Deploy key from Subgraph Studio.
GRAPH_DEPLOY_KEY=
SUBGRAPH_SLUG=aval-worldchain
GRAPH_NETWORK=worldchain

# Contract addresses and the deployment block for subgraph.yaml.
# startBlock MUST be the deployment block. Leaving it at 0 means a full-chain
# scan that will not finish before you need it.
AVAL_REGISTRY_ADDRESS=
REPORT_REGISTRY_ADDRESS=
PLATFORM_REGISTRY_ADDRESS=
PRESENCE_DRIP_ADDRESS=
DEPLOY_BLOCK=

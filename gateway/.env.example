# @aval/gateway — environment configuration
# Copy to .env and fill in. Never commit real values.

# ── HTTP ─────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Gateway signing key (EIP-191) ───────────────────────────────────────
# The gateway signs every CCIP-Read response so the on-chain resolver's
# resolveWithProof() can verify it via ecrecover. This key's address must
# match the signer configured on the L1Resolver contract. NEVER hardcode
# this in source — it is read from the environment only (see src/sign.ts).
GATEWAY_SIGNER_PRIVATE_KEY=0x...

# How long a signed response is valid for, in seconds. Kept short because
# the underlying data can change every 5s (see gateway->Subgraph TTL below).
GATEWAY_SIGNATURE_TTL_SECONDS=30

# ── The Graph ────────────────────────────────────────────────────────────
# Subgraph Studio / Gateway deployment id and query URL for aval-worldchain.
AVAL_SUBGRAPH_ID=
AVAL_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/aval-worldchain/version/latest
GRAPH_API_KEY=

# x402 fallback — used when GRAPH_API_KEY is unset (docs/05-graph-data-layer.md §4)
X402_PRIVATE_KEY=
X402_CHAIN=base

# ── World Chain ──────────────────────────────────────────────────────────
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
ADDRESS_BOOK_ADDRESS=0x57b930D551e677CC36e2fA036Ae2fe8FdaE0330D

# ── Caching (docs/04-ens.md §3.2) ───────────────────────────────────────
GATEWAY_SUBGRAPH_TTL_MS=5000
GATEWAY_RESPONSE_TTL_SECONDS=30

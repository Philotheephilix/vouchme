# The example mini apps are deployed with this directory as the upload root, not their own
# folders: each one depends on the SDK as `file:../vouchme-sdk`, so the sibling has to be present.
# Vercel's Root Directory setting then selects `fiar` or `lend`.
.next/
.next-*/

# Local secrets. Every value lives in the Vercel project's Environment Variables instead; an
# uploaded .env.local would override them during `next build`.
.env
.env.*
!.env.example

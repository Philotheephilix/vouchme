# Where VouchMe lives. Fiar speaks HTTP to it and nothing else.
VOUCHME_API_URL=http://localhost:3000

# Required for sign-in. Signs the challenge nonce and the session cookie.
# Generate with: openssl rand -hex 32
# Without it the catalogue still works (scores are public) but nobody can sign in or borrow.
FIAR_SESSION_SECRET=

# Chain used ONLY to answer ERC-1271 signature questions. World App wallets are smart contract
# accounts, so verifying a walletAuth signature is an on-chain call, not ecrecover.
NEXT_PUBLIC_CHAIN_ID=480
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public

# Which card the browser preview opens on. Ignored entirely once a wallet is verified.
FIAR_DEMO_HOLDER=carol.alice.vouchme.eth

# ─── payments (MiniKit.pay on World Chain mainnet) ──────────────────────────────
# Public app id from the World Developer Portal.
NEXT_PUBLIC_APP_ID=

# Team API key. Fiar will not mark a deposit paid on a client's say-so, so payments are
# disabled without it. Keep it out of version control.
DEV_PORTAL_API_KEY=

# Where deposits land. MUST be whitelisted under Payments in the Developer Portal app,
# or World App refuses the transfer.
FIAR_PAYMENT_RECIPIENT=

# What actually moves on chain, in WLD. The karma-derived deposit stays a real dollar figure and
# is shown next to this everywhere. 0.01 keeps the demo cheap while the money is genuinely real.
# Set to 0 to charge the true deposit instead.
FIAR_SETTLEMENT_WLD=0.01

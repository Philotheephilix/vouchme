# ─── VouchMe ─────────────────────────────────────────────────────────────────
# Where VouchMe lives. Lend speaks HTTP to it and nothing else. Point at a local dev server in
# fixture mode for development; a deployment for production.
VOUCHME_API_URL=http://localhost:3000

# How long to wait on a VouchMe read. 4s suits a Subgraph-backed deployment; one reading the chain
# directly (VouchMe's live mode) answers in ~33s and needs far more.
VOUCHME_TIMEOUT_MS=4000

# ─── sign-in ─────────────────────────────────────────────────────────────────
# Signs the challenge nonce and the session cookie. Generate with: openssl rand -hex 32
# Without it nobody can sign in, so nobody can claim.
LEND_SESSION_SECRET=

# ─── World App ───────────────────────────────────────────────────────────────
# Public app id from the World Developer Portal. This app needs its OWN registration — reusing
# another mini app's id makes walletAuth fail inside World App.
NEXT_PUBLIC_APP_ID=

# ─── World ID Identity Check (preview) ───────────────────────────────────────
# Lend's own World ID relying-party registration, used ONLY for Identity Attestations. Leave these
# unset and Lend still runs: pools render, standing renders, the standing gate works. Every pool
# that needs an identity attestation simply stays SHUT, and says why — see
# example/lend/IDENTITY-CHECK-TESTING.md.
#
# Identity Check is in preview. Setting these does not by itself grant entitlement; without it World
# App will not produce an attestation and Lend will refuse, which is the intended behaviour.
#
# RP id from the Developer Portal — the same one the verify endpoint is keyed on
# (`/api/v4/verify/{rp_id}`). This app needs its OWN, not another mini app's.
LEND_WORLDID_RP_ID=
# The action Identity Check requests are signed against.
LEND_WORLDID_ACTION=lend-identity-check
# The RP signing key, 0x-prefixed. Signs `rp_context` server-side via `signRequest`. NEVER ship this
# to the browser: a client that can sign its own request context can mint its own challenges.
# For a "managed" RP registration the Developer Portal holds this key in KMS and returns it only on
# generation or rotation.
LEND_WORLDID_SIGNING_KEY=

# Redirects World ID proof verification away from developer.world.org. DEVELOPMENT ONLY, and the app
# REFUSES TO BOOT if it is set on a production build (src/lib/identityStore.ts). It exists so
# `npm run test:identity` can exercise the branch where the verifier attests — otherwise the allow
# path of a preview-gated feature would be code that has never once executed. Leave it unset.
# LEND_IDENTITY_VERIFY_URL=

# ─── chain ───────────────────────────────────────────────────────────────────
# World Chain mainnet. Used to answer ERC-1271 signature questions (World App wallets are smart
# contract accounts, so verifying walletAuth is an on-chain call, not ecrecover) and to send the
# payout.
NEXT_PUBLIC_CHAIN_ID=480
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public

# ─── treasury (this moves real money) ────────────────────────────────────────
# The wallet claims are paid FROM. A funded EOA private key, 0x-prefixed.
#
# Leave it unset and Lend still runs: scores render, pools render, gates evaluate. Only claiming
# fails, and it fails with an error naming this variable rather than pretending to have paid.
#
# The account needs WLD to send and ETH on World Chain for gas. Both are checked before every
# transfer; a short balance is refused rather than broadcast.
LEND_TREASURY_PRIVATE_KEY=
